FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Mininet, Open vSwitch, and utility commands
RUN apt-get update && apt-get install -y \
    mininet \
    openvswitch-switch \
    openvswitch-common \
    iproute2 \
    iputils-ping \
    iperf \
    python3 \
    python3-yaml \
    python3-pip \
    curl \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends ethtool \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY sdn/ sdn/
COPY config/ config/
COPY fleet/ fleet/
COPY docker/mininet-entrypoint.sh /usr/local/bin/mininet-entrypoint
RUN chmod +x /usr/local/bin/mininet-entrypoint

# Ryu connects outbound to port 6633; this container exposes no listening port.
ENTRYPOINT ["/usr/local/bin/mininet-entrypoint"]
