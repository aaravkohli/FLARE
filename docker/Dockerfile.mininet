FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Mininet, Open vSwitch, and utility commands
RUN apt-get update && apt-get install -y \
    mininet \
    openvswitch-switch \
    openvswitch-common \
    iproute2 \
    iputils-ping \
    iperf \
    python3 \
    python3-pip \
    curl \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY sdn/ sdn/
COPY config/ config/

# Expose nothing by default (Ryu connects outbound to 6633)
# We will start OVS and the custom topology script
ENTRYPOINT ["/bin/bash", "-c", "(service openvswitch-switch start || true) && (pgrep ovs-vswitchd || ovs-vswitchd --pidfile --detach) && python3 sdn/mininet_topo.py"]
