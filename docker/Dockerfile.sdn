# Python 3.9 required for Ryu compatibility
FROM python:3.9-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Ryu 4.34 still uses setup.py/setup_requires. Pin its legacy build toolchain so
# a newer pbr release cannot break otherwise identical container builds.
RUN pip install --no-cache-dir \
    "setuptools==57.5.0" \
    "pbr==5.11.1" \
    "tomli==2.0.2"
RUN pip install --no-cache-dir \
    "eventlet==0.30.2" \
    "ryu==4.34" \
    fastapi \
    uvicorn \
    pyyaml

COPY sdn/ sdn/
COPY config/ config/
ENV PYTHONPATH=/app

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Default: run mock SDN (change CMD for real Ryu: ryu-manager sdn/controller.py)
CMD ["python", "sdn/mock_sdn.py"]
