FROM python:3.11-slim

WORKDIR /app

# System dependencies for httpx, sqlite
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir \
    fastapi "uvicorn[standard]" httpx tenacity \
    stable-baselines3 gymnasium \
    numpy scipy pyyaml jsonschema scikit-learn pandas \
    python-multipart sse-starlette aiosqlite \
    "python-jose[cryptography]" "passlib[bcrypt]"

COPY . .
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Create required directories
RUN mkdir -p models logs experiments

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "orchestrator.loop"]
