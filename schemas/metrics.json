{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DroneRFMetrics",
  "description": "Per-drone RF metric snapshot across all 3 communication paths",
  "type": "object",
  "required": ["drone_id", "timestamp", "source", "paths"],
  "additionalProperties": false,
  "properties": {
    "drone_id": {
      "type": "string",
      "enum": ["drone_1", "drone_2", "drone_3"],
      "description": "Unique drone identifier"
    },
    "timestamp": {
      "type": "number",
      "description": "Unix epoch timestamp (seconds)"
    },
    "source": {
      "type": "string",
      "enum": ["synthetic", "live", "synthetic_fallback", "legacy_api_fallback"],
      "description": "Provenance of this telemetry snapshot"
    },
    "paths": {
      "type": "array",
      "description": "Metrics for each of the 3 communication paths",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["path_id", "rssi", "pdr", "sinr", "latency", "packet_loss"],
        "additionalProperties": false,
        "properties": {
          "path_id": {
            "type": "string",
            "enum": ["direct", "satellite", "mesh"],
            "description": "Communication path identifier"
          },
          "rssi": {
            "type": "number",
            "minimum": -130,
            "maximum": 0,
            "description": "Received Signal Strength Indicator (dBm)"
          },
          "pdr": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Packet Delivery Ratio (0–1)"
          },
          "sinr": {
            "type": "number",
            "description": "Signal-to-Interference-plus-Noise Ratio (dB)"
          },
          "latency": {
            "type": "number",
            "minimum": 0,
            "description": "One-way latency in milliseconds"
          },
          "packet_loss": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Fraction of packets lost (0–1)"
          }
        }
      }
    },
    "gps": {
      "type": "object",
      "required": ["latitude", "longitude", "drift_m"],
      "additionalProperties": false,
      "properties": {
        "latitude": {"type": "number"},
        "longitude": {"type": "number"},
        "drift_m": {"type": "number", "minimum": 0}
      }
    },
    "ew_status": {
      "type": "object",
      "required": ["active_attack", "jammed_paths"],
      "additionalProperties": false,
      "properties": {
        "active_attack": {"type": ["string", "null"]},
        "jammed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["direct", "satellite", "mesh"]
          }
        }
      }
    }
  }
}
