# =============================================================================
# FLARE Environment Configuration
# Copy this file to .env and adjust variables as needed for your environment.
# =============================================================================

# Application environment: development | production
AJ_ENV=development

# Authentication & Security
# In production, AJ_SECRET_KEY must be >= 32 random characters.
AJ_SECRET_KEY=antijam-development-secret-do-not-use-in-production
AJ_ADMIN_USERNAME=admin
AJ_ADMIN_PASSWORD=antijam2026

# Networking & Ports
# Host to bind the API server (use 0.0.0.0 for LAN or container access, 127.0.0.1 for local only)
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173

# Allowed CORS origins (comma-separated). Add your local LAN IP (e.g., http://192.168.1.50:5173) if accessing from another device.
AJ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend API target (used during React dev server or container build)
VITE_API_BASE_URL=http://localhost:8000

# Execution mode: simulation | real
MODE=simulation

# SDN Controller Configuration
# In simulation mode: mock (runs sdn/mock_sdn.py)
# In real mode: ryu (requires Ryu controller + Open vSwitch)
AJ_SDN_MODE=mock
SDN_HOST=127.0.0.1
SDN_PORT=8080
SDN_HOST_BIND=0.0.0.0
AJ_SDN_TOKEN=antijam-development-sdn-token
AJ_SDN_READINESS_TIMEOUT=1.0
AJ_READINESS_HISTORY_LIMIT=100

# Federated Learning (FL) Server
FL_SERVER_HOST=0.0.0.0
FL_SERVER_PORT=8090
FL_SERVER_ADDRESS=0.0.0.0:8090

# Persistence & Storage
DATABASE_PATH=experiments/experiment.db
MODEL_DIR=./models
PROCESSED_DATA_DIR=./datasets/processed

# Sensor Adapter (used in real mode for live telemetry)
AJ_SENSOR_API_URL=http://localhost:9000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

