# Development values are intentionally shown only as examples.
# Generate unique secrets before using AJ_ENV=production.
AJ_ENV=development
AJ_SECRET_KEY=replace-with-at-least-32-random-characters
AJ_ADMIN_USERNAME=admin
AJ_ADMIN_PASSWORD=replace-with-a-strong-password
AJ_CORS_ORIGINS=http://localhost:5173
MODE=simulation
AJ_SDN_MODE=mock
AJ_SDN_TOKEN=replace-with-at-least-24-random-characters
SDN_HOST=127.0.0.1
SDN_PORT=8080
AJ_SDN_READINESS_TIMEOUT=1.0
AJ_READINESS_HISTORY_LIMIT=100
AJ_SENSOR_API_URL=http://localhost:9000
PROCESSED_DATA_DIR=./datasets/processed
VITE_API_BASE_URL=http://localhost:8000
