# =============================================================================
# FLARE — Comprehensive .gitignore
# =============================================================================

# =============================================================================
# macOS
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db
*.AppleDouble
*.LSOverride
Icon

# =============================================================================
# Environment & Secrets
# =============================================================================
.env
.env.*
!.env.example
*.secret
secrets/
config/secrets.yaml
**/credentials.json

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
venv/
.venv/
env/
ENV/
.virtualenv/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.whl
*.tar.gz
MANIFEST

# Linters & type checkers
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# Testing
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
pytest.xml
report.xml

# Jupyter
.ipynb_checkpoints/
*.ipynb

# =============================================================================
# Node / Frontend (frontend-react/)
# =============================================================================
node_modules/
frontend-react/node_modules/
frontend-react/dist/
frontend-react/.vite/
frontend-react/coverage/
*.tsbuildinfo
/frontend-react/blob-report/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# =============================================================================
# ML / AI Artifacts
# =============================================================================
# Trained model weights — large binary files, not source code
models/

# RL training checkpoints
rl/checkpoints/
rl/logs/
rl/tensorboard_logs/

# Datasets — raw and processed (too large for git)
datasets/
datasets/raw/
datasets/processed/
datasets/DroneRF/
datasets/RadioML*/
DroneRF/
RadioML*/

# Attached datasets and design artifacts
/design-md/
/flare-ui-refinement/
/RadioML 2018.01A */

# External simulator source trees — install/build separately, not project source
mininet-wifi/
ns-3-dev/

# Results & evaluation outputs
results/*.csv
results/*.json
results/runs/
results/*.provenance.json
!results/byzantine_experiment.json
!results/fl_resilience_matrix.csv
!results/fl_resilience_matrix.json
!results/network_security_experiment.json
!results/network_security_experiment.json.provenance.json
results/plots/
results/.plot_cache/
experiments/*.csv
experiments/*.db
experiments/evaluation_report.json

# =============================================================================
# Runtime Logs & Process Files
# =============================================================================
logs/
*.log
*.log.*
*.out
*.err
orchestrator_startup.log
uvicorn_startup.log
.local_sim.pids

# =============================================================================
# Database Files (runtime state)
# =============================================================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# =============================================================================
# Docker
# =============================================================================
docker/volumes/
docker/.env

# =============================================================================
# Benchmarks & Profiling
# =============================================================================
.benchmarks/
benchmarks/
*.prof
*.pstats

# =============================================================================
# Editor & IDE
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# =============================================================================
# Misc
# =============================================================================
*.pid
*.seed
*.tmp
*.temp
tmp/
temp/
.cache/

# Isolated live mission registry, client state, training outputs
/runtime/swarm_session/
/frontend-react/test-results/
/frontend-react/playwright-report/

# =============================================================================
# Documentation & Working Notes
# =============================================================================
docs/
*.md
!README.md
!**/README.md
!SWARM_NETWORK.md

# =============================================================================
# Images, Screenshots & UI Validation Artifacts
# =============================================================================
*.png
*.jpg
*.jpeg
*.webp
*.gif
!frontend-react/src/**
!frontend-react/public/**

# UI Validation / Repair run directories
/frontend-react/artifacts/
frontend-react/artifacts/live-mission-upgrade/
frontend-react/artifacts/swarm-repair-*/
**/screenshots/

# Panel review: preserve guides, selected evidence, and the final editable deck.
!/review-preparation/*.md
!/review-preparation/evidence/*.md
!/review-preparation/evidence/*.png
!/review-preparation/evidence/final-rehearsal/*.png
!/review-preparation/presentation/output/FLARE-speaker-script.md

# Private slide-authoring buffers, intermediate exports, and download archives.
/review-preparation/presentation/.build/
/review-preparation/presentation/.chart-data-*/
/review-preparation/presentation/output/*.pptx
!/review-preparation/presentation/output/FLARE-panel-review.pptx
/review-preparation/*.zip


# Audited, reproducible mesh reference benchmark
# Streamed study traces and disposable execution evidence are retained locally.
/results/adaptive_resilience/
!results/mesh_topology_benchmark_v2.json
!results/mesh_topology_benchmark_v2.csv

# Disposable resilience-pilot traces and local test evidence; release record is in validation/.
/results/evidence_resilience/
!/validation/evidence_resilience/evidence/*.png

# Isolated autonomous-recovery execution traces and local logs.
/results/autonomous_recovery/
!/validation/autonomous_recovery/evidence/*.png

# Affected-UAV assistance traces and disposable validation services.
/results/affected_uav_assistance/
!/validation/affected_uav_assistance/evidence/*.png
